# Copy this to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit secrets.

aws_profile = "genalpha"
aws_region  = "ap-south-1"

vercel_api_token = "vck_your_token_here"
github_repo      = "Spardha-Org/genalphacli"

# Leave empty to auto-generate secure random values
db_password       = ""
tps_secret        = ""
worker_secret     = ""
fernet_key        = ""
magic_link_secret = ""

# Your IP for SSH access (run: curl ifconfig.me)
my_ip = "0.0.0.0/0"

# Resend API key for magic link emails
resend_api_key = ""
