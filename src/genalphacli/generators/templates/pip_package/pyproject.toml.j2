[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ cli_name }}"
version = "0.1.0"
description = "Auto-generated CLI for {{ cli_name }}"
requires-python = ">=3.10"
dependencies = [
    "typer>=0.9.0",
    "rich>=13.0.0",
    "requests>=2.31.0",
]

[project.scripts]
{{ cli_name }} = "{{ cli_name }}.cli:app"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ cli_name }}"]
