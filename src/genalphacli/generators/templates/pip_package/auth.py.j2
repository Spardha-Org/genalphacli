"""Token management for {{ cli_name }}. Auto-generated by genalphacli.

Handles token storage, extraction, and resolution for CLI and MCP.
Shared config at: ~/.config/{{ cli_name }}/auth.json
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "{{ cli_name }}"
AUTH_FILE = CONFIG_DIR / "auth.json"

# Token field priority (from OAuth2 RFC 6749 + real API survey of 12+ APIs)
TOKEN_KEYS = [
    "access_token", "token", "jwt", "id_token", "auth_token", "session_token",
    "accessToken", "idToken", "authToken", "bearerToken",
    "access", "key",
]

# Common response wrappers to search one level deep
WRAPPER_KEYS = ["data", "result", "response", "payload", "session", "auth"]

# False positive field names to skip
SKIP_KEYS = {"csrf_token", "csrfToken", "session_id", "request_id", "correlation_id"}


def get_token() -> str:
    """Resolve token: env var -> auth.json -> empty string."""
    # Priority 1: environment variable
    env_token = os.environ.get("{{ auth_env_var }}", "")
    if env_token:
        return env_token

    # Priority 2: stored auth file
    stored = load_auth()
    if stored:
        return stored.get("token", "")

    return ""


def extract_token(response_data: dict) -> tuple[str, str]:
    """Extract token from login response using cascading confidence.

    Returns (token_value, field_path) or ("", "") if not found.
    """
    if not isinstance(response_data, dict):
        return "", ""

    # Signal boost: if token_type is present, this is OAuth2 — high confidence
    if "token_type" in response_data:
        for key in TOKEN_KEYS:
            val = response_data.get(key)
            if val and isinstance(val, str) and len(val) > 8:
                return val, key

    # Level 1: Check top-level common keys
    for key in TOKEN_KEYS:
        val = response_data.get(key)
        if val and isinstance(val, str) and len(val) > 8 and key not in SKIP_KEYS:
            return val, key

    # Level 1.5: Check one level deep in common wrappers
    for wrapper in WRAPPER_KEYS:
        nested = response_data.get(wrapper)
        if isinstance(nested, dict):
            for key in TOKEN_KEYS:
                val = nested.get(key)
                if val and isinstance(val, str) and len(val) > 8:
                    return val, f"{wrapper}.{key}"

    return "", ""


def save_auth(token: str, field_path: str) -> None:
    """Save token to auth.json with restricted permissions (atomic write)."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    data = {"token": token, "token_field_path": field_path}
    tmp = AUTH_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    os.replace(str(tmp), str(AUTH_FILE))
    os.chmod(AUTH_FILE, 0o600)
    print(f"Token saved to {AUTH_FILE}", file=sys.stderr)


def load_auth() -> dict | None:
    """Load auth.json if it exists. Returns None on error."""
    if AUTH_FILE.exists():
        try:
            return json.loads(AUTH_FILE.read_text())
        except (json.JSONDecodeError, OSError):
            return None
    return None


def clear_auth() -> None:
    """Delete stored token."""
    AUTH_FILE.unlink(missing_ok=True)
