[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ cli_name }}-mcp"
version = "0.1.0"
description = "MCP server for {{ cli_name }} API"
requires-python = ">=3.10"
dependencies = [
    "fastmcp>=2.0",
    "httpx>=0.27",
]

[project.scripts]
{{ cli_name }}-mcp = "{{ cli_name }}_mcp.server:main"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ cli_name }}_mcp"]
